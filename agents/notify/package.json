{
  "name": "notify-agent",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "rollAgent": {
    "runtime": {
      "ownership": "on-demand",
      "transport": "stdio"
    },
    "start": {
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "src/index.ts"
      ]
    }
  },
  "dependencies": {
    "@roll-agent/sdk": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
