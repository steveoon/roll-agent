{
  "name": "@roll-agent/smart-reply-agent",
  "version": "0.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveoon/roll-agent"
  },
  "homepage": "https://github.com/steveoon/roll-agent",
  "bugs": {
    "url": "https://github.com/steveoon/roll-agent/issues"
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "data/brand-config.sample.json",
    "data/reply-policy.json"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../scripts/bundle.mjs && node ../../scripts/obfuscate.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "rollAgent": {
    "runtime": {
      "ownership": "on-demand",
      "transport": "stdio"
    },
    "start": {
      "command": "node",
      "args": [
        "dist/index.js"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.13",
    "@ai-sdk/anthropic": "^3.0.53",
    "@ai-sdk/deepseek": "^2.0.22",
    "@ai-sdk/google": "^3.0.36",
    "@ai-sdk/openai": "^3.0.39",
    "@ai-sdk/openai-compatible": "^2.0.33",
    "@roll-agent/sdk": "workspace:*",
    "ai": "^6.0.108",
    "ora": "^8.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
