{
  "name": "@roll-agent/runtime",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveoon/roll-agent"
  },
  "homepage": "https://github.com/steveoon/roll-agent",
  "bugs": {
    "url": "https://github.com/steveoon/roll-agent/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./skills": {
      "types": "./src/skills/index.ts",
      "default": "./src/skills/index.ts"
    },
    "./tool-contracts": {
      "types": "./src/tool-contracts/index.ts",
      "default": "./src/tool-contracts/index.ts"
    },
    "./host-contracts": {
      "types": "./src/host-contracts/index.ts",
      "default": "./src/host-contracts/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./skills": {
        "types": "./dist/skills/index.d.ts",
        "default": "./dist/skills/index.js"
      },
      "./tool-contracts": {
        "types": "./dist/tool-contracts/index.d.ts",
        "default": "./dist/tool-contracts/index.js"
      },
      "./host-contracts": {
        "types": "./dist/host-contracts/index.d.ts",
        "default": "./dist/host-contracts/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/obfuscate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.31",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@roll-agent/protocol": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "ai": "7.0.146",
    "diff": "9.0.0",
    "yaml": "2.8.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
