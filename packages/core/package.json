{
  "name": "@roll-agent/core",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "bin": {
    "roll": "./bin/roll.js"
  },
  "files": ["dist", "bin"],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^4.3.0",
    "@ai-sdk/anthropic": "^1.2.0",
    "citty": "^0.1.6",
    "chalk": "^5.4.0",
    "ora": "^8.1.0",
    "cli-table3": "^0.6.5",
    "gray-matter": "^4.0.3",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
