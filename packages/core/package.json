{
  "name": "@roll-agent/core",
  "version": "0.12.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveoon/roll-agent"
  },
  "homepage": "https://github.com/steveoon/roll-agent",
  "bugs": {
    "url": "https://github.com/steveoon/roll-agent/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./mcp/*": {
      "types": "./src/mcp/*.ts",
      "default": "./src/mcp/*.ts"
    },
    "./llm/*": {
      "types": "./src/llm/*.ts",
      "default": "./src/llm/*.ts"
    },
    "./registry/*": {
      "types": "./src/registry/*.ts",
      "default": "./src/registry/*.ts"
    },
    "./tool-runtime/*": {
      "types": "./src/tool-runtime/*.ts",
      "default": "./src/tool-runtime/*.ts"
    },
    "./config/*": {
      "types": "./src/config/*.ts",
      "default": "./src/config/*.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    },
    "./cli/utils/*": {
      "types": "./src/cli/utils/*.ts",
      "default": "./src/cli/utils/*.ts"
    }
  },
  "bin": {
    "roll": "./bin/roll.js"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "./mcp/*": {
        "types": "./dist/mcp/*.d.ts",
        "default": "./dist/mcp/*.js"
      },
      "./llm/*": {
        "types": "./dist/llm/*.d.ts",
        "default": "./dist/llm/*.js"
      },
      "./registry/*": {
        "types": "./dist/registry/*.d.ts",
        "default": "./dist/registry/*.js"
      },
      "./tool-runtime/*": {
        "types": "./dist/tool-runtime/*.d.ts",
        "default": "./dist/tool-runtime/*.js"
      },
      "./config/*": {
        "types": "./dist/config/*.d.ts",
        "default": "./dist/config/*.js"
      },
      "./types/*": {
        "types": "./dist/types/*.d.ts",
        "default": "./dist/types/*.js"
      },
      "./cli/utils/*": {
        "types": "./dist/cli/utils/*.d.ts",
        "default": "./dist/cli/utils/*.js"
      }
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-sqlite src/cli/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/obfuscate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test \"src/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --experimental-sqlite --test \"src/**/*.e2e.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.3",
    "@ai-sdk/anthropic": "^4.0.4",
    "@ai-sdk/deepseek": "^3.0.2",
    "@ai-sdk/openai": "^4.0.4",
    "@ai-sdk/provider": "^4.0.1",
    "@clack/prompts": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@roll-agent/runtime": "workspace:*",
    "ai": "^7.0.9",
    "chalk": "^5.4.0",
    "citty": "^0.1.6",
    "cli-table3": "^0.6.5",
    "gray-matter": "^4.0.3",
    "ink": "7.0.1",
    "marked": "18.0.5",
    "ora": "^8.1.0",
    "react": "19.2.7",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.16",
    "ink-testing-library": "4.0.0"
  }
}
