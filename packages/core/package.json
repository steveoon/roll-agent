{
  "name": "@roll-agent/core",
  "version": "0.5.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveoon/roll-agent"
  },
  "homepage": "https://github.com/steveoon/roll-agent",
  "bugs": {
    "url": "https://github.com/steveoon/roll-agent/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "bin": {
    "roll": "./bin/roll.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/obfuscate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --test \"src/**/*.e2e.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.17",
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/deepseek": "^2.0.29",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/provider": "^3.0.8",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^6.0.154",
    "chalk": "^5.4.0",
    "citty": "^0.1.6",
    "cli-table3": "^0.6.5",
    "gray-matter": "^4.0.3",
    "ora": "^8.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
