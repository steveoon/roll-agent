{
  "name": "@roll-agent/relay-protocol",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveoon/roll-agent"
  },
  "homepage": "https://github.com/steveoon/roll-agent",
  "bugs": {
    "url": "https://github.com/steveoon/roll-agent/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "default": "./src/conformance.ts"
    },
    "./reference-adapter": {
      "types": "./src/reference-adapter.ts",
      "default": "./src/reference-adapter.ts"
    },
    "./control": {
      "types": "./src/control.ts",
      "default": "./src/control.ts"
    },
    "./control/schema": "./dist/schema/roll-relay-control-v1.schema.json",
    "./control/session-schema": "./dist/schema/roll-relay-browser-session-v1.schema.json",
    "./control/fixtures/*": "./fixtures/control/v1.0/*",
    "./schema": "./dist/schema/roll-relay-protocol-v1.schema.json",
    "./schema/v1.0": "./dist/schema/roll-relay-protocol-v1.schema.json",
    "./schema/v1.1": "./dist/schema/roll-relay-protocol-v1.1.schema.json",
    "./fixtures/*": "./fixtures/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      },
      "./reference-adapter": {
        "types": "./dist/reference-adapter.d.ts",
        "default": "./dist/reference-adapter.js"
      },
      "./control": {
        "types": "./dist/control.d.ts",
        "default": "./dist/control.js"
      },
      "./control/schema": "./dist/schema/roll-relay-control-v1.schema.json",
      "./control/session-schema": "./dist/schema/roll-relay-browser-session-v1.schema.json",
      "./control/fixtures/*": "./fixtures/control/v1.0/*",
      "./schema": "./dist/schema/roll-relay-protocol-v1.schema.json",
      "./schema/v1.0": "./dist/schema/roll-relay-protocol-v1.schema.json",
      "./schema/v1.1": "./dist/schema/roll-relay-protocol-v1.1.schema.json",
      "./fixtures/*": "./fixtures/*"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node --experimental-strip-types scripts/generate-schema.mjs && node --experimental-strip-types scripts/generate-control-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@roll-agent/protocol": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.8.1"
  }
}
