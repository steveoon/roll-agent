{
  "name": "@roll-agent/browser",
  "version": "0.7.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveoon/roll-agent"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../scripts/bundle.mjs && node ../../scripts/obfuscate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "playwright-core": "^1.52.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
