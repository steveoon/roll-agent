{
  "name": "roll-agent-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "node --experimental-strip-types packages/core/src/cli/index.ts",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @roll-agent/core run test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-packages": "pnpm build && changeset publish",
    "release:legacy": "node scripts/release.mjs",
    "release:legacy:dry-run": "node scripts/release.mjs --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "eslint": "^9.0.0",
    "neostandard": "^0.12.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0"
  }
}
